---
import Base from "../../../layouts/Base.astro"
import { excerpt, formatDate, postsFor, t, typeOf, type Lang } from "../../../lib/site"

export const getStaticPaths = () => [{ params: { lang: "nl" } }, { params: { lang: "en" } }]
const lang = Astro.params.lang as Lang
const l = t[lang]
const posts = await postsFor(lang)
const other = lang === "nl" ? "en" : "nl"
// Filter buttons only once there is more than one kind of post to choose between
const kinds = ["mind", "experiment"]
  .map((type) => ({ type, label: l.sections[type].title, count: posts.filter((p) => typeOf(p) === type).length }))
  .filter((k) => k.count > 0)
---

<Base title={`${l.all} · mindwrapper`} lang={lang} alternate={`/${other}/posts/`}>
  <section class="narrow">
    <h1>{l.all}</h1>
    {
      kinds.length > 1 && (
        <div class="filter meta" role="group" aria-label={l.filterLabel}>
          <button type="button" data-filter="" aria-pressed="true">
            {l.filterAll} <span class="count">{posts.length}</span>
          </button>
          {kinds.map((k) => (
            <button type="button" data-filter={k.type} aria-pressed="false">
              {k.label} <span class="count">{k.count}</span>
            </button>
          ))}
        </div>
      )
    }
    <ol>
      {
        posts.map((post) => (
          <li data-type={typeOf(post)}>
            <span class="meta">{formatDate(post.data.date, lang)} · {l.types[typeOf(post)]}</span>
            <a href={`/${post.id}`}>{post.data.title}</a>
            <p>{excerpt(post, 140)}</p>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<script>
  // Without JavaScript every post stays visible; #mind or #experiment in the URL picks a filter
  const buttons = [...document.querySelectorAll<HTMLButtonElement>(".filter button")]
  const items = [...document.querySelectorAll<HTMLLIElement>("li[data-type]")]
  const apply = (type: string) => {
    if (type && !buttons.some((b) => b.dataset.filter === type)) type = ""
    for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.filter === type))
    for (const li of items) li.hidden = Boolean(type) && li.dataset.type !== type
  }
  for (const b of buttons) {
    b.addEventListener("click", () => {
      const type = b.dataset.filter ?? ""
      history.replaceState(null, "", type ? `#${type}` : location.pathname)
      apply(type)
    })
  }
  if (buttons.length) apply(location.hash.slice(1))
</script>

<style>
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 400; margin: 3rem 0 2rem; }
  .filter { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.5rem; }
  .filter button {
    font: inherit;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-raised);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .filter button:hover { color: var(--ink); border-color: var(--ink-faint); }
  .filter button[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .filter .count { opacity: 0.7; margin-left: 0.2rem; }
  ol { list-style: none; padding: 0; margin: 0; }
  li { padding: 1.3rem 0; border-top: 1px solid var(--rule); }
  li a { display: block; font-size: 1.55rem; color: var(--ink); line-height: 1.25; margin: 0.2rem 0 0.4rem; }
  li a:hover { color: var(--accent); }
  li p { margin: 0; font-family: var(--sans); font-size: 0.95rem; color: var(--ink-soft); }
</style>
