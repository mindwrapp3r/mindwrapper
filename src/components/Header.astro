---
import { t, type Lang } from "../lib/site"

interface Props {
  lang: Lang
  alternate?: string
}
const { lang, alternate } = Astro.props
const l = t[lang]
const here = Astro.url.pathname.replace(/\.html$/, "")
const target = (to: Lang) => (to === lang ? here : (alternate ?? `/${to}/`))
---

<header class="wrap site-header">
  <a class="wordmark" href={`/${lang}/`}>
    <svg class="mark" viewBox="6 11 144 92" aria-hidden="true">
      <g fill="none" stroke-width="7" stroke-linecap="round">
        <path class="wrap" d="M 15.34 65.35 L 16.38 61.85 L 18.27 58.28 L 20.99 54.70 L 24.50 51.14 L 28.75 47.67 L 33.69 44.33 L 39.24 41.16 L 45.32 38.22 L 51.86 35.53 L 58.77 33.14 L 65.94 31.08 L 73.27 29.38 L 80.67 28.07 L 88.04 27.15 L 95.26 26.65 L 102.25 26.57 L 108.90 26.91 L 115.12 27.67 L 120.83 28.84 L 125.94 30.39 L 130.39 32.32 L 134.11 34.58 L 137.06 37.16 L 139.18 40.01"></path>
        <path class="ink" d="M69.15 35 69.63 41.53 51.82 72.38Q51.82 72.38 51.24 73.43Q50.67 74.49 50.1 76.01Q49.53 77.52 49.49 79H48.93L46.56 73.77ZM28.5 73.42V77.8H21.85V77.2Q21.91 77.2 22.36 77.2Q22.81 77.2 22.81 77.2Q24.43 77.2 25.69 76.21Q26.95 75.22 27.18 73.42ZM31.15 74.38Q31.15 74.44 31.15 74.5Q31.15 74.56 31.15 74.68Q31.15 75.64 31.84 76.45Q32.53 77.26 33.49 77.26H34.42V77.8H30.73V74.38ZM32.15 35H32.72L34.82 41.01L30.78 77.8H26.63ZM32.72 35 52.31 67.17 48.93 79 31.18 49.21ZM69.69 35 75.39 77.8H65.77L62.72 50.24L69.15 35ZM73.52 73.42H74.82Q75.11 75.22 76.36 76.21Q77.6 77.2 79.19 77.2Q79.19 77.2 79.65 77.2Q80.11 77.2 80.15 77.2V77.8H73.52ZM65.39 74.38H65.81V77.8H62.12V77.26H63.06Q64.04 77.26 64.72 76.45Q65.39 75.64 65.39 74.68Q65.39 74.56 65.39 74.5Q65.39 74.44 65.39 74.38Z"></path>
        <path class="ink" transform="rotate(180 78 57)" d="M69.15 35 69.63 41.53 51.82 72.38Q51.82 72.38 51.24 73.43Q50.67 74.49 50.1 76.01Q49.53 77.52 49.49 79H48.93L46.56 73.77ZM28.5 73.42V77.8H21.85V77.2Q21.91 77.2 22.36 77.2Q22.81 77.2 22.81 77.2Q24.43 77.2 25.69 76.21Q26.95 75.22 27.18 73.42ZM31.15 74.38Q31.15 74.44 31.15 74.5Q31.15 74.56 31.15 74.68Q31.15 75.64 31.84 76.45Q32.53 77.26 33.49 77.26H34.42V77.8H30.73V74.38ZM32.15 35H32.72L34.82 41.01L30.78 77.8H26.63ZM32.72 35 52.31 67.17 48.93 79 31.18 49.21ZM69.69 35 75.39 77.8H65.77L62.72 50.24L69.15 35ZM73.52 73.42H74.82Q75.11 75.22 76.36 76.21Q77.6 77.2 79.19 77.2Q79.19 77.2 79.65 77.2Q80.11 77.2 80.15 77.2V77.8H73.52ZM65.39 74.38H65.81V77.8H62.12V77.26H63.06Q64.04 77.26 64.72 76.45Q65.39 75.64 65.39 74.68Q65.39 74.56 65.39 74.5Q65.39 74.44 65.39 74.38Z"></path>
        <path class="wrap" d="M 140.66 48.65 L 139.62 52.15 L 137.73 55.72 L 135.01 59.30 L 131.50 62.86 L 127.25 66.33 L 122.31 69.67 L 116.76 72.84 L 110.68 75.78 L 104.14 78.47 L 97.23 80.86 L 90.06 82.92 L 82.73 84.62 L 75.33 85.93 L 67.96 86.85 L 60.74 87.35 L 53.75 87.43 L 47.10 87.09 L 40.88 86.33 L 35.17 85.16 L 30.06 83.61 L 25.61 81.68 L 21.89 79.42 L 18.94 76.84 L 16.82 73.99"></path>
      </g>
    </svg>
    <span class="word">mind<span>wrapper</span></span>
  </a>
  <nav>
    <a href={`/${lang}/posts/`}>{l.all}</a>
    <a href={l.aboutPath}>{l.about}</a>
    <span class="lang-switch" aria-label="Taal / Language">
      {
        (["nl", "en"] as Lang[]).map((to) => (
          <a
            href={target(to)}
            hreflang={to}
            aria-label={to === "nl" ? "Nederlands" : "English"}
            class={to === lang ? "active" : ""}
            aria-current={to === lang ? "page" : undefined}
          >
            {to === "nl" ? (
              <svg viewBox="0 0 9 6" aria-hidden="true">
                <rect width="9" height="6" fill="#21468B" />
                <rect width="9" height="4" fill="#fff" />
                <rect width="9" height="2" fill="#AE1C28" />
              </svg>
            ) : (
              <svg viewBox="0 0 60 30" aria-hidden="true">
                <clipPath id="uk-t">
                  <path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" />
                </clipPath>
                <rect width="60" height="30" fill="#012169" />
                <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
                <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#uk-t)" stroke="#C8102E" stroke-width="4" />
                <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
                <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
              </svg>
            )}
            <span class="code">{to.toUpperCase()}</span>
          </a>
        ))
      }
    </span>
    <a class="icon" href={l.searchPath} aria-label={l.search} title={l.search}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </a>
    <button class="theme-toggle" type="button" aria-label={l.theme} title={l.theme}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" />
      </svg>
    </button>
  </nav>
</header>

<script>
  document.querySelector(".theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement
    root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark"
    try {
      localStorage.setItem("theme", root.dataset.theme)
    } catch {}
  })
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    font-family: var(--sans);
    font-size: 0.95rem;
  }
  .wordmark {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .wordmark { display: inline-flex; align-items: center; gap: 0.45rem; }
  .word span { color: var(--accent); font-style: italic; font-weight: 500; }
  .mark { height: 2.4rem; width: auto; aspect-ratio: 144 / 92; flex-shrink: 0; }
  .mark .wrap { stroke: var(--accent); }
  .mark .ink { fill: var(--ink); stroke: none; }
  nav { display: flex; align-items: center; gap: 1.3rem; flex-wrap: wrap; justify-content: flex-end; }
  nav > a { color: var(--ink-soft); }
  nav > a:hover { color: var(--accent); }
  .lang-switch {
    display: inline-flex;
    border: 1px solid var(--rule);
    border-radius: 999px;
    overflow: hidden;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .lang-switch a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.7rem;
    color: var(--ink-faint);
  }
  .lang-switch a + a { border-left: 1px solid var(--rule); }
  .lang-switch a.active { background: var(--paper-raised); color: var(--ink); }
  .lang-switch svg { width: 1.05rem; height: 0.7rem; border-radius: 2px; }
  .theme-toggle {
    background: none;
    border: none;
    color: var(--ink-soft);
    cursor: pointer;
    padding: 0.2rem;
    display: inline-flex;
  }
  .theme-toggle svg, .icon svg { width: 1.3rem; height: 1.3rem; }
  .icon { display: inline-flex; color: var(--ink-soft); }
  .theme-toggle:hover { color: var(--accent); }
  @media (max-width: 640px) {
    .site-header { padding-top: 1rem; padding-bottom: 1rem; }
    nav { gap: 0.7rem; flex-wrap: nowrap; }
    nav > a:not(.icon) { display: none; }
    .wordmark { font-size: 1.3rem; gap: 0.3rem; }
    .mark { height: 1.9rem; }
    .lang-switch .code { display: none; }
    .lang-switch a { padding: 0.35rem 0.6rem; }
  }
</style>
