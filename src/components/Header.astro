---
import { t, type Lang } from "../lib/site"

interface Props {
  lang: Lang
  alternate?: string
}
const { lang, alternate } = Astro.props
const l = t[lang]
const target = (to: Lang) => (to === lang ? Astro.url.pathname : (alternate ?? `/${to}/`))
---

<header class="wrap site-header">
  <a class="wordmark" href={`/${lang}/`}>mind<span>wrapper</span></a>
  <nav>
    <a href={`/${lang}/posts/`}>{l.all}</a>
    <a href={l.aboutPath}>{l.about}</a>
    <span class="lang-switch" aria-label="Taal / Language">
      {
        (["nl", "en"] as Lang[]).map((to) => (
          <a
            href={target(to)}
            hreflang={to}
            class={to === lang ? "active" : ""}
            aria-current={to === lang ? "page" : undefined}
          >
            {to === "nl" ? (
              <svg viewBox="0 0 9 6" aria-hidden="true">
                <rect width="9" height="6" fill="#21468B" />
                <rect width="9" height="4" fill="#fff" />
                <rect width="9" height="2" fill="#AE1C28" />
              </svg>
            ) : (
              <svg viewBox="0 0 60 30" aria-hidden="true">
                <clipPath id="uk-t">
                  <path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" />
                </clipPath>
                <rect width="60" height="30" fill="#012169" />
                <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
                <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#uk-t)" stroke="#C8102E" stroke-width="4" />
                <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
                <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
              </svg>
            )}
            {to.toUpperCase()}
          </a>
        ))
      }
    </span>
    <button class="theme-toggle" type="button" aria-label={l.theme} title={l.theme}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" />
      </svg>
    </button>
  </nav>
</header>

<script>
  document.querySelector(".theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement
    root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark"
    try {
      localStorage.setItem("theme", root.dataset.theme)
    } catch {}
  })
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    font-family: var(--sans);
    font-size: 0.95rem;
  }
  .wordmark {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .wordmark span { color: var(--accent); font-style: italic; font-weight: 500; }
  nav { display: flex; align-items: center; gap: 1.3rem; flex-wrap: wrap; justify-content: flex-end; }
  nav > a { color: var(--ink-soft); }
  nav > a:hover { color: var(--accent); }
  .lang-switch {
    display: inline-flex;
    border: 1px solid var(--rule);
    border-radius: 999px;
    overflow: hidden;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .lang-switch a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.7rem;
    color: var(--ink-faint);
  }
  .lang-switch a + a { border-left: 1px solid var(--rule); }
  .lang-switch a.active { background: var(--paper-raised); color: var(--ink); }
  .lang-switch svg { width: 1.05rem; height: 0.7rem; border-radius: 2px; }
  .theme-toggle {
    background: none;
    border: none;
    color: var(--ink-soft);
    cursor: pointer;
    padding: 0.2rem;
    display: inline-flex;
  }
  .theme-toggle svg { width: 1.3rem; height: 1.3rem; }
  .theme-toggle:hover { color: var(--accent); }
  @media (max-width: 640px) {
    .site-header { padding-top: 1rem; padding-bottom: 1rem; }
    nav { gap: 0.8rem; }
    nav > a:first-child { display: none; }
  }
</style>
